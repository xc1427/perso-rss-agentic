# Hoist the "scraper runtime" libraries (libraries that generated scrapers
# inside apps/{app}/src/generated/ are allowed to import) to the workspace
# root node_modules. Without this, pnpm's strict isolation hides these
# packages from the generated scrapers' own location, and the agent burns
# turns trying to resolve them.
public-hoist-pattern[]=cheerio
public-hoist-pattern[]=cheerio-*
public-hoist-pattern[]=tsx
